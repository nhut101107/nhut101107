package com.mnhutx.playtogether.gate;

import android.app.Activity;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.text.InputType;
import android.view.Gravity;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.TextView;

public final class KeyGateActivity extends Activity {
    private EditText key;
    private TextView error;
    @Override public void onCreate(Bundle state) {
        super.onCreate(state);
        LinearLayout box = new LinearLayout(this);
        box.setOrientation(LinearLayout.VERTICAL); box.setGravity(Gravity.CENTER_HORIZONTAL);
        int pad = (int)(24 * getResources().getDisplayMetrics().density);
        box.setPadding(pad, pad, pad, pad);
        TextView title = new TextView(this);
        title.setText("Play Together MNHUT"); title.setTextSize(24); box.addView(title);
        key = new EditText(this); key.setHint("Nhập key");
        key.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
        key.setSingleLine(true); box.addView(key, new LinearLayout.LayoutParams(-1, -2));
        Button submit = new Button(this); submit.setText("Xác nhận"); box.addView(submit);
        error = new TextView(this); error.setTextSize(16); box.addView(error);
        submit.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View ignored) { verifyAndOpen(); }
        });
        setContentView(box);
    }
    private void verifyAndOpen() {
        String entered = key.getText().toString();
        if (!"mnhut".equals(entered)) {
            error.setText(entered.length() == 0 ? "Key không được để trống" : "Key không chính xác");
            return;
        }
        Intent incoming = getIntent(); Intent game = new Intent();
        game.setClassName(this, "__GAME_ACTIVITY__");
        String action = incoming.getAction();
        if (action != null && !Intent.ACTION_MAIN.equals(action)) game.setAction(action);
        Uri data = incoming.getData(); if (data != null) game.setData(data);
        if (incoming.getCategories() != null)
            for (String category : incoming.getCategories()) game.addCategory(category);
        Bundle source = incoming.getExtras();
        if (source != null) {
            Bundle safe = new Bundle();
            for (String name : source.keySet()) {
                Object value = source.get(name);
                if (value instanceof String) safe.putString(name, (String)value);
                else if (value instanceof Boolean) safe.putBoolean(name, (Boolean)value);
                else if (value instanceof Integer) safe.putInt(name, (Integer)value);
                else if (value instanceof Long) safe.putLong(name, (Long)value);
                else if (value instanceof Float) safe.putFloat(name, (Float)value);
                else if (value instanceof Double) safe.putDouble(name, (Double)value);
                else if (value instanceof String[]) safe.putStringArray(name, (String[])value);
                else if (value instanceof byte[]) safe.putByteArray(name, (byte[])value);
            }
            game.putExtras(safe);
        }
        // Never copy an untrusted component, Parcelable, Binder, or Serializable.
        startActivity(game); finish();
    }
    @Override public void onBackPressed() { finishAndRemoveTask(); }
}
