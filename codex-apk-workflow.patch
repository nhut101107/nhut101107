diff --git a/.github/workflows/build-play-together-mnhut.yml b/.github/workflows/build-play-together-mnhut.yml
new file mode 100644
index 0000000..5d03d5c
--- /dev/null
+++ b/.github/workflows/build-play-together-mnhut.yml
@@ -0,0 +1,51 @@
+name: Build Play Together MNHUT APK
+
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - ".github/workflows/build-play-together-mnhut.yml"
+      - "scripts/apk/**"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: play-together-mnhut-2.31.0
+  cancel-in-progress: false
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 360
+    env:
+      APK_FILE_ID: 1TUiPxl_jdMs-jQIwXC3uHnngFk937tkA
+      RELEASE_TAG: play-together-mnhut-2.31.0
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - name: Reclaim runner disk space
+        run: |
+          sudo rm -rf /usr/local/lib/android/sdk/ndk /usr/share/dotnet /opt/ghc || true
+          df -h .
+      - name: Install tools
+        run: scripts/apk/install-tools.sh
+      - name: Download and build
+        run: scripts/apk/build.sh
+      - name: Publish verified release assets with retry
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: scripts/apk/publish-release.sh
+      - name: Upload reports on failure
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: apk-build-diagnostics
+          path: |
+            work/logs/**
+            dist/*.txt
+          if-no-files-found: ignore
+
